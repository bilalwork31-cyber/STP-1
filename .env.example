# Required. OpenRouteService key for geocoding and truck routing: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Required. Any long random string.
DJANGO_SECRET_KEY=
# Optional. Defaults to false. Keep false in production.
DJANGO_DEBUG=false
# Optional. Comma separated host names. Defaults to localhost,127.0.0.1,.vercel.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,stp-1.vercel.app
